<div class="flex h-screen flex-col w-64 justify-between border-e border-border bg-base-200">
  <div class="px-4 py-6">
    <span class="grid h-10 w-32 place-content-center rounded-lg text-2xl">
      FitMate
    </span>

    <ul class="mt-6 space-y-1">
      <li>
        <%= link_to "Conversaciones", chats_path, class: "block rounded-lg bg-base-300 px-4 py-2 text-sm font-medium" %>
      </li>

      <li>
        <%= link_to "Rutinas", chats_path, class: "block rounded-lg px-4 py-2 text-sm font-medium text-gray-500 hover:bg-base-300 hover:text-gray-700" %>
      </li>

      <li>
        <a
          href="#"
          class="block rounded-lg px-4 py-2 text-sm font-medium text-gray-500 hover:bg-base-300 hover:text-gray-700"
        >
          Invoices
        </a>
      </li>

      <li>
        <details class="group [&_summary::-webkit-details-marker]:hidden">
          <summary
            class="flex cursor-pointer items-center justify-between rounded-lg px-4 py-2 text-gray-500 hover:bg-base-300 hover:text-gray-700"
          >
            <span class="text-sm font-medium"> Account </span>

            <span class="shrink-0 transition duration-300 group-open:-rotate-180">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
          </summary>

          <ul class="mt-2 space-y-1 px-4">
            <li>
              <a
                href="#"
                class="block rounded-lg px-4 py-2 text-sm font-medium text-gray-500 hover:bg-base-300 hover:text-gray-700"
              >
                Details
              </a>
            </li>

            <li>
              <a
                href="#"
                class="block rounded-lg px-4 py-2 text-sm font-medium text-gray-500 hover:bg-base-300 hover:text-gray-700"
              >
                Security
              </a>
            </li>

            <li>
              <a
                href="#"
                class="w-full rounded-lg px-4 py-2 [text-align:_inherit] text-sm font-medium text-gray-500 hover:bg-base-300 hover:text-gray-700"
              >
                Logout
              </a>
            </li>
          </ul>
        </details>
      </li>
    </ul>
  </div>

  <div class="sticky inset-x-0 bottom-0 border-t border-border">
    <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center gap-2 bg-base-300 p-4 hover:bg-base-200 w-full cursor-pointer" do %>
      <img
        alt=""
        src="https://images.unsplash.com/photo-1600486913747-55e5470d6f40?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1770&q=80"
        class="size-10 rounded-full object-cover hidden"
      />

      <div>
        <p class="text-xs">
          <strong class="hidden block font-medium">Eric Frusciante</strong>

          <span><%= current_user.email %></span>
        </p>
      </div>
    <% end %>
  </div>
</div>
